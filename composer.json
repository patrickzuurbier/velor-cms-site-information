{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "patrickzuurbier/velor-cms-site-information",
    "description": "Site Information resource plugin for Velor CMS.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "velor/cms": "^1.9"
    },
    "autoload": {
        "psr-4": {
            "Velor\\SiteInformation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Velor\\SiteInformation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Velor\\SiteInformation\\Providers\\SiteInformationServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
